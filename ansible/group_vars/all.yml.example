# =============================================================================
# reporker — configuration example
# Copy this to group_vars/all.yml and fill in your real values.
# group_vars/all.yml is gitignored so your credentials never get committed.
# =============================================================================

# --- GitLab connection (discovery uses glab API; clone/push use SSH) ---
gitlab:
  host: gitlab.com                   # your GitLab instance hostname
  group_id: 12345                    # numeric group ID to scan
  # Personal access token (needs api scope). Path relative to playbook_dir.
  # Create with: printf '%s' 'glpat-xxx' > glab/token && chmod 600 glab/token
  token_file: "{{ playbook_dir }}/../../glab/token"
  # Filter repos by name (last path segment, case-insensitive).
  # Empty list = clone everything in the group.
  repo_filter: []

# --- Local paths ---
paths:
  workspace: "{{ playbook_dir }}/../workspace"
  reports:   "{{ playbook_dir }}/../reports"

# --- Git settings for the publish phase ---
git:
  branch_name:    "reporker-{{ lookup('pipe', 'date +%Y%m%d') }}"
  commit_message: "chore: reporker automated change"

# --- Pluggable action ---
# reporker_action.name          : folder under ansible/actions/<name>/
# reporker_action.target_patterns : globs for ansible.builtin.find (recurse=true)
# reporker_action.params        : arbitrary dict available as reporker_action.params
reporker_action:
  name: noop
  target_patterns:
    - "*.___reporker_no_match___"
  params: {}

# ---------------------------------------------------------------------------
# Example action configs:
# ---------------------------------------------------------------------------

