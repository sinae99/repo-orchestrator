# =============================================================================
# reporker config example
# ./reporker init → copies this to group_vars/all.yml (gitignored). Edit that.
#
# This file is the WHERE (host, group, token).
# Task configs (WHAT) live in recipes/*.yml — prefer those over editing
# reporker_action here. See docs/README.md and AGENTS.md.
# =============================================================================

# --- GitLab (discovery via glab API; clone/push via SSH) ---
gitlab:
  host: gitlab.com
  group_id: 12345                    # change this
  # PAT with api scope — only auth step:
  #   printf '%s' 'glpat-xxx' > glab/token && chmod 600 glab/token
  token_file: "{{ playbook_dir }}/../../glab/token"
  repo_filter: []                    # empty = whole group; or ["api", "worker"]

paths:
  workspace: "{{ playbook_dir }}/../workspace"
  reports:   "{{ playbook_dir }}/../reports"

git:
  branch_name:    "reporker-{{ lookup('pipe', 'date +%Y%m%d') }}"
  commit_message: "chore: reporker automated change"

# --- Default action (overridden by --recipe) ---
# name            → ansible/actions/<name>/
# target_patterns → globs (recurse; includes hidden files like .gitlab-ci.yml)
# content_grep    → optional content filter
# params          → action-specific
reporker_action:
  name: inventory
  target_patterns:
    - "Dockerfile"
    - "Dockerfile.*"
  # content_grep: ""
  params: {}

# ---------------------------------------------------------------------------
# Prefer recipes over editing this file for each task:
#
#   ./reporker list
#   ./reporker action --recipe bump-python --dry-run
#   ./reporker action --recipe bump-python
#   ./reporker publish
#
# Starter recipes: recipes/
# Docs: docs/README.md · AGENTS.md
# ---------------------------------------------------------------------------
