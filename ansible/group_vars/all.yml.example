# =============================================================================
# reporker config example
# ./reporker init → copies this to group_vars/all.yml (gitignored). Edit that.
# More copy-paste configs: ansible/actions/README.md
# =============================================================================

# --- GitLab (discovery via glab API; clone/push via SSH) ---
gitlab:
  host: gitlab.com
  group_id: 12345                    # change this
  # PAT with api scope — only auth step:
  #   printf '%s' 'glpat-xxx' > glab/token && chmod 600 glab/token
  token_file: "{{ playbook_dir }}/../../glab/token"
  repo_filter: []                    # empty = whole group; or ["api", "worker"]

paths:
  workspace: "{{ playbook_dir }}/../workspace"
  reports:   "{{ playbook_dir }}/../reports"

git:
  branch_name:    "reporker-{{ lookup('pipe', 'date +%Y%m%d') }}"
  commit_message: "chore: reporker automated change"

# --- Action ---
# name            → ansible/actions/<name>/
# target_patterns → globs (recurse)
# content_grep    → optional content filter
# params          → action-specific
reporker_action:
  name: inventory
  target_patterns:
    - "Dockerfile"
    - "Dockerfile.*"
  # content_grep: ""
  params: {}

# ---------------------------------------------------------------------------
# Copy one block over reporker_action (and git, when shown).
# ---------------------------------------------------------------------------

# inventory (read) — list matched files per repo:
# reporker_action:
#   name: inventory
#   target_patterns:
#     - "Dockerfile"
#     - "docker-compose.y*ml"

# grep (read) — pattern matches with line numbers:
# reporker_action:
#   name: grep
#   target_patterns:
#     - "*.yaml"
#     - "*.yml"
#   params:
#     pattern: "image:\\s*latest"
#     ignore_case: false

# missing-file (read) — repos that lack a required file:
# reporker_action:
#   name: missing-file
#   target_patterns:
#     - ".gitlab-ci.yml"

# noop (read) — wiring / scan-only:
# reporker_action:
#   name: noop
#   target_patterns:
#     - "*"

# priorityclass (write) — drop medium/low requests, ensure priorityClassName:
# reporker_action:
#   name: priorityclass
#   target_patterns:
#     - "*.yaml"
#     - "*.yml"
# git:
#   branch_name: "reporker-priorityclass-{{ lookup('pipe', 'date +%Y%m%d') }}"
#   commit_message: "chore: drop medium/low requests and add priorityClassName medium where missing"

# line-append (write) — ensure a line exists:
# reporker_action:
#   name: line-append
#   target_patterns:
#     - "requirements.txt*"
#   params:
#     ensure_line: "# managed by reporker"
#     insertafter: EOF

# replace (write) — regex find-and-replace:
# reporker_action:
#   name: replace
#   target_patterns:
#     - "Dockerfile"
#   params:
#     regexp: "^FROM python:3\\.9"
#     replace: "FROM python:3.12"

# ensure-file (write) — create a standard file if missing:
# reporker_action:
