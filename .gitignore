# glab runtime files — tokens and generated clone lists never get committed.
# Only the README in glab/ is tracked.
glab/*
!glab/README.md

# Local config override (real host/group values stay out of git)
ansible/group_vars/all.yml

# Working trees and reports
ansible/workspace/*
!ansible/workspace/.keep
ansible/reports/*
!ansible/reports/.keep
!ansible/reports/README.md

# Offline test workspace (rebuilt by ./reporker test)
tests/.work/

# Ansible
*.retry
ansible/.ansible-tmp/
.ansible/

# Python
__pycache__/
*.py[cod]

# Local test / temp dirs
tmp*/

# Editors / OS / agents
.DS_Store
.vscode/
.idea/
.claude/

# Local hamgit export (push separately, then delete)
COPY/
